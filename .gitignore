# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Local CSV data/import files
*.csv

# FSL (Field Service Lightning) managed package fields - auto-retrieved, not project-owned
**/fields/FSL__*.field-meta.xml

# Empty WorkOrder object shell auto-generated by retrieve
force-app/main/default/objects/WorkOrder/WorkOrder.object-meta.xml

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

## 작업 문서
docs

## 백업 파일
.flow-backups/
