<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Type</field>
        <field>StageName</field>
        <field>Expansion_Capacity__c</field>
        <field>Residual_Risk__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>lukert+crm@gachon.ac.kr.t1sales</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>내부 추진 승인 단계</label>
        <name>Internal_Approval_Step</name>
    </approvalStep>
    <description>Hall B 등 증설(Type=Existing Business) Opportunity가 SELL 단계로 넘어가기 전 내부 추진 승인을 받는다. 승인자(User)는 org마다 다시 지정해야 한다 — User 참조는 배포되지 않는다.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND( ISPICKVAL(Type, "Existing Business"), NOT(ISPICKVAL(Internal_Approval_Status__c, "승인")) )</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Opp_Internal_Approval_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Opp_Internal_Approval_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Opp_Internal_Approval_In_Review</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Hall B 내부 추진 승인</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
