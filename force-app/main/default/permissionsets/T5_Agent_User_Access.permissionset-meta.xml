<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>T5 Agent User Access</label>
    <description>OT Service Agent User가 Case 생성·Asset 조회에 필요한 최소 권한</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Case</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Asset</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- T5-22: search_knowledge Action이 WITH USER_MODE로 조회 — 이 권한
             없으면 Agent 실행 계정에서 QueryException으로 조용히 에러난다
             (2026-08-30 CLI 프리뷰로 실측 확인). -->
        <object>Knowledge__kav</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Case.Symptom_Category__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Impact_Level__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Reported_Symptom__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Warranty_Decision__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Coverage_Type__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Billable__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Dispatch_Briefing__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Similar_Cases_Summary__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Knowledge_No_Match_At_Intake__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- T5-22: search_knowledge Action의 WITH USER_MODE 쿼리가 SELECT/WHERE에
         쓰는 필드들 — 오브젝트 Read만으론 부족했다(2026-08-30 실측: Object
         권한은 확인됐는데도 Agent 실행 계정에서 계속 에러나서 필드 단위임을
         확인). Knowledge__kav는 관리형 특수 오브젝트라 표준 필드도 명시적
         FLS가 필요한 것으로 보임. -->
    <fieldPermissions>
        <field>Knowledge__kav.Summary</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Knowledge__kav.Title/UrlName은 required 필드라 FLS 배포 자체가 거부됨
         ("You cannot deploy to a required field") — 항상 자동 접근 가능하므로
         제외(T3 CLAUDE.md에 이미 기록된 동일 패턴, 2026-08-30 재확인). -->

    <classAccesses>
        <apexClass>T5AgentCaseIntakeAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>T5AgentKnowledgeSearchAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
