<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>T5 Agent User Access</label>
    <description>OT Service Agent User가 Case 생성·Asset 조회에 필요한 최소 권한</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Case</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Asset</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- T5-22: search_knowledge Action이 WITH USER_MODE로 조회 — 이 권한
             없으면 Agent 실행 계정에서 QueryException으로 조용히 에러난다
             (2026-08-30 CLI 프리뷰로 실측 확인). -->
        <object>Knowledge__kav</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- T5-23: escalate 시 Case를 MessagingSession에 연결(CaseId Update),
             자산 컨텍스트 조회 시 Asset_Id__c 읽기. -->
        <object>MessagingSession</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- MessagingSession Read가 요구하는 의존 권한(배포 에러로 확인,
             2026-08-31) — MessagingEndUser 없이는 MessagingSession도 못 읽음. -->
        <object>MessagingEndUser</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Product2</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <!-- T5-08: get_asset_context의 게이지(resolveGaugesForAgent)·정비이력
             (formatMaintenanceHistory) 조회가 user-mode로 실행 — 이 권한 없으면
             WOLI/WorkOrder SOQL이 UserModeQueryException("not supported")로 죽고
             catch에 삼켜져 found=false가 된다(2026-09-01 실채팅 2:21PM 로그 실측). -->
        <object>WorkOrderLineItem</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>WorkOrder</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>WorkType</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- T5-22 재검증(2026-08-30): create_case_from_agent 실행 시
         "Operation failed due to fields being inaccessible on Sobject Case"
         에러 발생 — 커스텀 필드는 FLS가 있었는데 표준 필드(AssetId 등)엔
         하나도 없었던 게 원인. Agent Action 실행 컨텍스트는 표준 필드도
         명시적 FLS를 요구하는 것으로 보임(Knowledge__kav 표준 필드도 같은
         패턴이었던 것과 동일). Origin/Subject/AccountId/ContactId/AssetId는
         required 필드가 아니라 배포 가능. -->
    <fieldPermissions>
        <field>Case.AssetId</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.AccountId</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.ContactId</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.EntitlementId</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Origin</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Subject</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Symptom_Category__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Impact_Level__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Reported_Symptom__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.ServiceContractId</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Warranty_Decision__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Coverage_Type__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Billable__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Dispatch_Briefing__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Similar_Cases_Summary__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Knowledge_No_Match_At_Intake__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- T5-22: search_knowledge Action의 WITH USER_MODE 쿼리가 SELECT/WHERE에
         쓰는 필드들 — 오브젝트 Read만으론 부족했다(2026-08-30 실측: Object
         권한은 확인됐는데도 Agent 실행 계정에서 계속 에러나서 필드 단위임을
         확인). Knowledge__kav는 관리형 특수 오브젝트라 표준 필드도 명시적
         FLS가 필요한 것으로 보임. -->
    <fieldPermissions>
        <field>Knowledge__kav.Summary</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Knowledge__kav.Title/UrlName은 required 필드라 FLS 배포 자체가 거부됨
         ("You cannot deploy to a required field") — 항상 자동 접근 가능하므로
         제외(T3 CLAUDE.md에 이미 기록된 동일 패턴, 2026-08-30 재확인). -->
    <fieldPermissions>
        <field>MessagingSession.Asset_Id__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>MessagingSession.CaseId</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.SerialNumber</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Site_Location__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Latest_Trend_Flag__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Warranty_Type__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Open_Items_Summary__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Asset.Latest_Gauges_JSON__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- T5-08: 게이지 조회(resolveGaugesForAgent)가 SELECT/WHERE에 쓰는 WOLI
         커스텀 필드 — 오브젝트 Read만으론 부족(Knowledge/Case와 동일 패턴,
         Agent user-mode 컨텍스트는 필드 단위 FLS를 요구). 2026-09-01 실측. -->
    <fieldPermissions>
        <field>WorkOrderLineItem.Measurement_Item_Code__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrderLineItem.Measured_Value__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrderLineItem.Baseline_Value__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrderLineItem.Delta_From_Previous__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrderLineItem.Previous_Measured_Value__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrderLineItem.Trend_Flag__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <!-- T5-08: 정비이력 조회(formatMaintenanceHistory)의 WorkOrder 표준 필드.
         AssetId는 게이지 조회 WHERE(WorkOrder.AssetId)에도 쓰인다. StartDate는
         두 조회의 ORDER BY 기준. -->
    <fieldPermissions>
        <field>WorkOrder.Subject</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrder.StartDate</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrder.Status</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>WorkOrder.AssetId</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>

    <classAccesses>
        <apexClass>T5AgentCaseIntakeAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>T5AgentKnowledgeSearchAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>T5AgentAssetContextAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <!-- get_entitlement 액션 타깃. 누락 시 플래너가 세션 시작 때 전 액션
             권한 검증에서 실패 → "Failed to create a new planner session"으로
             에이전트 전체가 안 뜬다(known-issues Issue: 플래너는 모든 서브에이전트의
             모든 액션 권한을 startup에 검증, 2026-09-01 preview로 실측 확인). -->
        <apexClass>T5AgentEntitlementContextAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
