<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>CR 3단계 승인</interviewLabel>
    <label>CR 3단계 승인</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Retrieves the ChangeRequest record using the input recordId to fetch Description, Cost_Impact__c, and Schedule_Impact_Days__c for display context</description>
        <name>Get_ChangeRequest_Record</name>
        <label>Get ChangeRequest Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Approval_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ChangeRequest</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Cost_Impact__c</queriedFields>
        <queriedFields>Schedule_Impact_Days__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the ChangeRequest record with approval outcome values collected from the Approval Screen including Internal Approved, Customer Approved, Revision No, Revision Approved Date, and Drawing URL</description>
        <name>Update_ChangeRequest_Record</name>
        <label>Update ChangeRequest Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Customer_Approved__c</field>
            <value>
                <elementReference>customerApproved</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Customer_Reply_Date__c</field>
            <value>
                <elementReference>customerReplyDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Drawing_URL__c</field>
            <value>
                <elementReference>drawingURL.value</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Internal_Approved__c</field>
            <value>
                <elementReference>internalApproved</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Revision_Approved_Date__c</field>
            <value>
                <elementReference>revisionApprovedDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Revision_No__c</field>
            <value>
                <elementReference>revisionNo</elementReference>
            </value>
        </inputAssignments>
        <object>ChangeRequest</object>
    </recordUpdates>
    <screens>
        <description>Approval screen displaying read-only ChangeRequest context (Description, Cost Impact, Schedule Impact Days) and collecting approval outcome data from the approver (Internal Approved, Customer Approved, Revision No, Revision Approved Date, Drawing URL)</description>
        <name>Approval_Screen</name>
        <label>Approval Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_ChangeRequest_Record</targetReference>
        </connector>
        <fields>
            <description>Display field showing the Description from the retrieved ChangeRequest record as read-only context</description>
            <name>descriptionDisplay</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Description:&lt;/b&gt; {!Get_ChangeRequest_Record.Description}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Display field showing the Cost Impact from the retrieved ChangeRequest record as read-only context</description>
            <name>costImpactDisplay</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Cost Impact:&lt;/b&gt; {!Get_ChangeRequest_Record.Cost_Impact__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Display field showing the Schedule Impact Days from the retrieved ChangeRequest record as read-only context</description>
            <name>scheduleImpactDaysDisplay</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Schedule Impact Days:&lt;/b&gt; {!Get_ChangeRequest_Record.Schedule_Impact_Days__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input date field for the approver to enter the customer reply date</description>
            <name>customerReplyDate</name>
            <dataType>Date</dataType>
            <fieldText>고객 회신일 (Customer Reply Date)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input checkbox field for the approver to indicate internal approval status</description>
            <name>internalApproved</name>
            <dataType>Boolean</dataType>
            <fieldText>Internal Approved</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input checkbox field for the approver to indicate customer approval status</description>
            <name>customerApproved</name>
            <dataType>Boolean</dataType>
            <fieldText>Customer Approved</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input text field for the approver to enter the revision number</description>
            <name>revisionNo</name>
            <dataType>String</dataType>
            <fieldText>Revision No</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input date field for the approver to enter the revision approved date</description>
            <name>revisionApprovedDate</name>
            <dataType>Date</dataType>
            <fieldText>Revision Approved Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input URL field for the approver to enter the drawing URL</description>
            <name>drawingURL</name>
            <extensionName>flowruntime:url</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Drawing URL</stringValue>
                </value>
            </inputParameters>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_ChangeRequest_Record</targetReference>
        </connector>
        <triggerType>None</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Input variable that receives the ChangeRequest record Id from the Flow Orchestration step</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
