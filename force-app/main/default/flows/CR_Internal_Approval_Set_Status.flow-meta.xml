<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>CR 내부 승인 완료 시 상태 분기 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CR 내부 승인 완료 시 상태 자동 분기</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Check_Impact</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Internal_Approved__c}) &amp;&amp; {!$Record.Internal_Approved__c}</filterFormula>
        <object>ChangeRequest</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <decisions>
        <name>Check_Impact</name>
        <label>비용·일정 영향 여부 확인</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Set_Status_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>영향 없음</defaultConnectorLabel>
        <rules>
            <name>Has_Impact</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Cost_Impact__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Schedule_Impact_Days__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Customer_Pending</targetReference>
            </connector>
            <label>영향 있음</label>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Status_Approved</name>
        <label>상태를 승인됨으로 설정</label>
        <locationX>50</locationX>
        <locationY>266</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>승인됨</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Status_Customer_Pending</name>
        <label>상태를 고객승인대기로 설정</label>
        <locationX>300</locationX>
        <locationY>266</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>고객승인대기</stringValue>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
