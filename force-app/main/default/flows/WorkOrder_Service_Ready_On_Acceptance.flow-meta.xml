<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <formulas>
        <name>FrequencyDaysFormula</name>
        <dataType>Number</dataType>
        <expression>CASE(TEXT({!Get_Asset.Maintenance_Frequency__c}),
&quot;월 1회&quot;, 30,
&quot;분기 1회&quot;, 90,
&quot;반기 1회&quot;, 180,
&quot;연 1회&quot;, 365,
90)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NextInspectionDateFormula</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Acceptance_Date__c} + {!FrequencyDaysFormula}</expression>
    </formulas>
    <formulas>
        <name>ServiceReadyStatusFormula</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Acceptance_Type__c}, &quot;최종인수&quot;), &quot;준비완료&quot;, &quot;조건부&quot;)</expression>
    </formulas>
    <interviewLabel>WorkOrder Service Ready On Acceptance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>WorkOrder Service Ready On Acceptance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Fetches the Asset to read its existing Maintenance_Frequency__c (assumed already set before acceptance) and to be updated with Service Ready fields</description>
        <name>Get_Asset</name>
        <label>Get Asset</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Asset_Service_Ready</targetReference>
        </connector>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Asset</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Maintenance_Frequency__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Sets Service Ready status/date/acceptor, enables maintenance, and computes the next inspection date</description>
        <name>Update_Asset_Service_Ready</name>
        <label>Update Asset Service Ready</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Maintenance_Enabled__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Next_Inspection_Date__c</field>
            <value>
                <elementReference>NextInspectionDateFormula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Service_Ready_Acceptor__c</field>
            <value>
                <elementReference>$Record.Accepted_By_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Service_Ready_Date__c</field>
            <value>
                <elementReference>$Record.Acceptance_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Service_Ready_Status__c</field>
            <value>
                <elementReference>ServiceReadyStatusFormula</elementReference>
            </value>
        </inputAssignments>
        <object>Asset</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Asset</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Acceptance_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>최종인수</stringValue>
            </value>
        </filters>
        <filters>
            <field>Acceptance_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>조건부인수</stringValue>
            </value>
        </filters>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
