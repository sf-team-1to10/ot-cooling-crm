<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>CR 2단계 기술영향</interviewLabel>
    <label>CR 2단계 기술영향</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Retrieves the ChangeRequest record by Id to display context information and prepare for update</description>
        <name>Lookup_ChangeRequest</name>
        <label>Lookup ChangeRequest</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Technical_Assessment_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ChangeRequest</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Scope_Type__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the ChangeRequest record with the three technical assessment values collected from the screen</description>
        <name>Update_ChangeRequest_Assessment</name>
        <label>Update ChangeRequest Assessment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Cost_Impact__c</field>
            <value>
                <elementReference>costImpact</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Schedule_Impact_Days__c</field>
            <value>
                <elementReference>scheduleImpactDays</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Technical_Impact__c</field>
            <value>
                <elementReference>technicalImpact</elementReference>
            </value>
        </inputAssignments>
        <object>ChangeRequest</object>
    </recordUpdates>
    <screens>
        <description>Screen displaying ChangeRequest context (Description, Scope Type) and collecting technical assessment inputs (Cost Impact, Schedule Impact Days, Technical Impact)</description>
        <name>Technical_Assessment_Screen</name>
        <label>Technical Assessment Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_ChangeRequest_Assessment</targetReference>
        </connector>
        <fields>
            <description>Read-only display field showing the Description from the retrieved ChangeRequest record</description>
            <name>changeRequestDescription</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Description:&lt;/b&gt; {!Lookup_ChangeRequest.Description}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Read-only display field showing the Scope Type from the retrieved ChangeRequest record</description>
            <name>changeRequestScopeType</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Scope Type:&lt;/b&gt; {!Lookup_ChangeRequest.Scope_Type__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input field for engineer to enter the cost impact assessment as currency value</description>
            <name>costImpact</name>
            <dataType>Currency</dataType>
            <fieldText>Cost Impact</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>Enter the estimated cost impact of this change request</helpText>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input field for engineer to enter the schedule impact in days as numeric value</description>
            <name>scheduleImpactDays</name>
            <dataType>Number</dataType>
            <fieldText>Schedule Impact Days</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>Enter the number of days this change will impact the schedule</helpText>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Large text area input field for engineer to enter detailed technical impact assessment</description>
            <name>technicalImpact</name>
            <fieldText>Technical Impact</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <helpText>Provide a detailed assessment of the technical impact</helpText>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Lookup_ChangeRequest</targetReference>
        </connector>
        <triggerType>None</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Input variable that receives the ChangeRequest record Id when the flow is launched</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
