<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Updates the triggering ChangeRequest record&apos;s Status to &apos;적용중&apos; (Applying) when minor change criteria are met, allowing the change to skip technical review</description>
        <name>Set_Status_To_Applying</name>
        <label>Set Status To Applying</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>적용중</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Evaluates if this is a minor change that can skip technical review by checking: Scope_Type__c equals &apos;원계약 범위&apos; AND Cost_Impact__c equals 0 AND Schedule_Impact_Days__c equals 0 AND (Status equals &apos;요청받음&apos; OR Status equals &apos;검토중&apos;)</description>
        <name>Check_Minor_Change_Criteria</name>
        <label>Check Minor Change Criteria</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <description>Minor change criteria met: original contract scope, zero cost impact, zero schedule impact, and status is either &apos;요청받음&apos; or &apos;검토중&apos;</description>
            <name>Minor_Change_Criteria_Met</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Scope_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>원계약 범위</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cost_Impact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Schedule_Impact_Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>요청받음</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>검토중</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_To_Applying</targetReference>
            </connector>
            <label>Minor Change Criteria Met</label>
        </rules>
    </decisions>
    <description>경미·무상 변경(원계약 범위+비용영향0+일정영향0)을 판별 직후 &apos;적용중&apos;으로 자동 전환. 기술검토(D4) 우회. 근거: UC 통합본 &apos;원칙 3&apos;. triggerOrder=1 (내부승인 Flow보다 먼저 실행).</description>
    <environments>Default</environments>
    <interviewLabel>CR Minor Change Trigger</interviewLabel>
    <label>CR Minor Change Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Minor_Change_Criteria</targetReference>
        </connector>
        <filterFormula>(ISCHANGED({!$Record.Scope_Type__c}) || ISCHANGED({!$Record.Cost_Impact__c}) || ISCHANGED({!$Record.Schedule_Impact_Days__c})) &amp;&amp; (ISPICKVAL({!$Record.Status}, &apos;요청받음&apos;) || ISPICKVAL({!$Record.Status}, &apos;검토중&apos;))</filterFormula>
        <object>ChangeRequest</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1</triggerOrder>
</Flow>
