<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Calls the Dispatch_Briefing_Generator prompt template with the assembled measurement history, equipment name, and the current reading</description>
        <name>Call_Prompt</name>
        <label>Call Prompt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Dispatch_Briefing_Generator</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Save_Briefing</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:Measurement_History</name>
            <value>
                <elementReference>varHistory</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Equipment_Name</name>
            <value>
                <elementReference>Get_This_Case.Subject</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Dispatch_Briefing_Generator</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>varBriefing</assignToReference>
            <name>promptResponse</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Builds formatted measurement history by concatenating WorkOrderLineItem fields with the parent WorkOrder StartDate</description>
        <name>Build_History</name>
        <label>Build History</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHistory</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>History_Line</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Current</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Builds the peer comparison text by concatenating peer equipment readings, kept separate from the current asset history</description>
        <name>Build_Peer</name>
        <label>Build Peer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPeerComparison</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Peer_Line</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Peers</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Captures the latest inspection flow reading as the current value, once only</description>
        <name>Capture_Current</name>
        <label>Capture Current</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCurrentReading</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Current_Reading_Line</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCaptured</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_WOLIs</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Captures the current value only from the latest inspection flow reading, once</description>
        <name>Check_Current</name>
        <label>Check Current</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_WOLIs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Current</defaultConnectorLabel>
        <rules>
            <name>Is_Current_Reading</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaptured</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_WOLIs.Line_Item_Role__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>점검</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_WOLIs.Measurement_Item_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>유량</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Current</targetReference>
            </connector>
            <label>Is Current Reading</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Current_Reading_Line</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(MONTH(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(DAY(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos; 측정 &apos; &amp; TEXT({!Loop_WOLIs.Measurement_Item_Code__c}) &amp; &apos; &apos; &amp; TEXT({!Loop_WOLIs.Measured_Value__c}) &amp; &apos; | 기준선 &apos; &amp; TEXT({!Loop_WOLIs.Baseline_Value__c}) &amp; &apos; | 기준선대비 &apos; &amp; TEXT({!Loop_WOLIs.Drift_From_Baseline__c}) &amp; &apos;% | 판정 &apos; &amp; TEXT({!Loop_WOLIs.Judgement__c}) &amp; &apos; | 추세 &apos; &amp; TEXT({!Loop_WOLIs.Trend_Flag__c})</expression>
    </formulas>
    <formulas>
        <name>History_Line</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(MONTH(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(DAY(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos; | &apos; &amp; TEXT({!Loop_WOLIs.Line_Item_Role__c}) &amp; &apos; | &apos; &amp; TEXT({!Loop_WOLIs.Measurement_Item_Code__c}) &amp; &apos; | 측정 &apos; &amp; TEXT({!Loop_WOLIs.Measured_Value__c}) &amp; &apos; | 기준선 &apos; &amp; TEXT({!Loop_WOLIs.Baseline_Value__c}) &amp; &apos; | 기준선대비 &apos; &amp; TEXT({!Loop_WOLIs.Drift_From_Baseline__c}) &amp; &apos;% | 판정 &apos; &amp; TEXT({!Loop_WOLIs.Judgement__c}) &amp; &apos; | 추세 &apos; &amp; TEXT({!Loop_WOLIs.Trend_Flag__c}) &amp; &apos; | 회차 &apos; &amp; TEXT({!Loop_WOLIs.Retest_Round__c}) &amp; &apos; | 사유 &apos; &amp; TEXT({!Loop_WOLIs.Retest_Reason__c}) &amp; &apos; | 조치 &apos; &amp; {!Loop_WOLIs.Corrective_Action__c} &amp; &apos;\n&apos;</expression>
    </formulas>
    <formulas>
        <name>Peer_Line</name>
        <dataType>String</dataType>
        <expression>{!Loop_Peers.Asset.Name} &amp; &apos; | 측정 &apos; &amp; TEXT({!Loop_Peers.Measured_Value__c}) &amp; &apos; | 기준선대비 &apos; &amp; TEXT({!Loop_Peers.Drift_From_Baseline__c}) &amp; &apos;%\n&apos;</expression>
    </formulas>
    <interviewLabel>Case_Dispatch_Briefing_Generate</interviewLabel>
    <label>Case_Dispatch_Briefing_Generate</label>
    <loops>
        <description>Iterates through peer equipment inspection line items to build the peer comparison text, kept separate from the current asset history</description>
        <name>Loop_Peers</name>
        <label>Loop Peers</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Peer_WOLIs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Peer</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Call_Prompt</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterates through the current WorkOrder&apos;s line items to build formatted history text</description>
        <name>Loop_WOLIs</name>
        <label>Loop WOLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_WOLIs_Inner</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_History</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_WOs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Iterates through WorkOrders newest first to read each WorkOrder&apos;s line items in date context</description>
        <name>Loop_WOs</name>
        <label>Loop WOs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Asset_WOs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_WOLIs_Inner</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Peer_WOLIs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Retrieves all WorkOrders on the same Asset, newest first, to iterate history in date order</description>
        <name>Get_Asset_WOs</name>
        <label>Get Asset WOs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_WOs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_This_Case.AssetId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>StartDate</queriedFields>
        <queriedFields>Subject</queriedFields>
        <sortField>StartDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves peer equipment inspection flow readings, excluding the current asset, for peer comparison</description>
        <name>Get_Peer_WOLIs</name>
        <label>Get Peer WOLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Peers</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssetId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_This_Case.AssetId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Measurement_Item_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>유량</stringValue>
            </value>
        </filters>
        <filters>
            <field>Line_Item_Role__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>점검</stringValue>
            </value>
        </filters>
        <filters>
            <field>Measured_Value__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>WorkOrderLineItem</object>
        <sortField>AssetId</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the current Case to access its AssetId</description>
        <name>Get_This_Case</name>
        <label>Get This Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Asset_WOs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>AssetId</queriedFields>
        <queriedFields>Subject</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves this WorkOrder&apos;s line items that have a measured value</description>
        <name>Get_WOLIs_Inner</name>
        <label>Get WOLIs Inner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_WOLIs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WorkOrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_WOs.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Measured_Value__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>WorkOrderLineItem</object>
        <queriedFields>Measurement_Item_Code__c</queriedFields>
        <queriedFields>Measured_Value__c</queriedFields>
        <queriedFields>Baseline_Value__c</queriedFields>
        <queriedFields>Drift_From_Baseline__c</queriedFields>
        <queriedFields>Judgement__c</queriedFields>
        <queriedFields>Line_Item_Role__c</queriedFields>
        <queriedFields>Retest_Round__c</queriedFields>
        <queriedFields>Retest_Reason__c</queriedFields>
        <queriedFields>Corrective_Action__c</queriedFields>
        <queriedFields>Trend_Flag__c</queriedFields>
        <sortField>Measurement_Item_Code__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Writes the generated dispatch briefing to the current Case</description>
        <name>Save_Briefing</name>
        <label>Save Briefing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Show_History</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Dispatch_Briefing__c</field>
            <value>
                <elementReference>varBriefing</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <screens>
        <description>Displays the generated dispatch briefing to the user</description>
        <name>Show_History</name>
        <label>Show History</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>measurementHistoryDisplay</name>
            <fieldText>{!varBriefing}</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_This_Case</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Input variable that receives the current Case Id when the flow is launched</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Text variable that holds the generated dispatch briefing returned by the prompt template</description>
        <name>varBriefing</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Flag ensuring the current reading is captured only once, from the newest inspection WorkOrder</description>
        <name>varCaptured</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Holds the latest inspection flow reading, passed to the prompt as the authoritative current value</description>
        <name>varCurrentReading</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Text variable that accumulates formatted measurement history lines for display</description>
        <name>varHistory</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Accumulates peer equipment comparison lines, kept completely separate from varHistory, passed to the prompt as Peer_Comparison</description>
        <name>varPeerComparison</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
