    <decisions>
        <description>Captures the current value only from the latest inspection flow reading, once</description>
        <name>Check_Current</name>
        <label>Check Current</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_WOLIs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Current</defaultConnectorLabel>
        <rules>
            <name>Is_Current_Reading</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaptured</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_WOLIs.Line_Item_Role__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>점검</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_WOLIs.Measurement_Item_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>유량</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Current</targetReference>
            </connector>
            <label>Is Current Reading</label>
        </rules>
    </decisions>
    <decisions>
        <description>Guards against calling the prompt with empty history — if no measurement data was collected, shows an informational screen instead of failing</description>
        <name>Check_History</name>
        <label>Check History</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Show_No_Data</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No History</defaultConnectorLabel>
        <rules>
            <name>Has_History</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHistory</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Search_Similar_Cases</targetReference>
            </connector>
            <label>Has History</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes to the similar-case prompt only when past closed cases were found; otherwise skips straight to the briefing so cases with no history still generate normally</description>
        <name>Check_Similar</name>
        <label>Check Similar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Call_Prompt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Similar Cases</defaultConnectorLabel>
        <rules>
            <name>Has_Similar_Cases</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Search_Similar_Cases.similarCases</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Search_Similar_Cases.similarCases</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Similar_Prompt</targetReference>
            </connector>
            <label>Has Similar Cases</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Current_Case_Line</name>
        <dataType>String</dataType>
        <expression>&apos;현재 Case | 증상분류 &apos; &amp; TEXT({!Get_This_Case.Symptom_Category__c}) &amp; &apos; | 장비 &apos; &amp; {!Get_This_Case.Subject}</expression>
    </formulas>
    <formulas>
        <name>Current_Reading_Line</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(MONTH(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(DAY(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos; 측정 &apos; &amp; TEXT({!Loop_WOLIs.Measurement_Item_Code__c}) &amp; &apos; &apos; &amp; TEXT({!Loop_WOLIs.Measured_Value__c}) &amp; &apos; | 기준선 &apos; &amp; TEXT({!Loop_WOLIs.Baseline_Value__c}) &amp; &apos; | 기준선대비 &apos; &amp; TEXT({!Loop_WOLIs.Drift_From_Baseline__c}) &amp; &apos;% | 판정 &apos; &amp; TEXT({!Loop_WOLIs.Judgement__c}) &amp; &apos; | 추세 &apos; &amp; TEXT({!Loop_WOLIs.Trend_Flag__c})</expression>
    </formulas>
    <formulas>
        <name>History_Line</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(MONTH(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos;-&apos; &amp; TEXT(DAY(DATEVALUE({!Loop_WOs.StartDate}))) &amp; &apos; | &apos; &amp; TEXT({!Loop_WOLIs.Line_Item_Role__c}) &amp; &apos; | &apos; &amp; TEXT({!Loop_WOLIs.Measurement_Item_Code__c}) &amp; &apos; | 측정 &apos; &amp; TEXT({!Loop_WOLIs.Measured_Value__c}) &amp; &apos; | 기준선 &apos; &amp; TEXT({!Loop_WOLIs.Baseline_Value__c}) &amp; &apos; | 기준선대비 &apos; &amp; TEXT({!Loop_WOLIs.Drift_From_Baseline__c}) &amp; &apos;% | 판정 &apos; &amp; TEXT({!Loop_WOLIs.Judgement__c}) &amp; &apos; | 추세 &apos; &amp; TEXT({!Loop_WOLIs.Trend_Flag__c}) &amp; &apos; | 회차 &apos; &amp; TEXT({!Loop_WOLIs.Retest_Round__c}) &amp; &apos; | 사유 &apos; &amp; TEXT({!Loop_WOLIs.Retest_Reason__c}) &amp; &apos; | 조치 &apos; &amp; {!Loop_WOLIs.Corrective_Action__c} &amp; &apos;\n&apos;</expression>
    </formulas>
    <formulas>
        <name>Peer_Line</name>
        <dataType>String</dataType>
        <expression>{!Loop_Peers.Asset.Name} &amp; &apos; | 측정 &apos; &amp; TEXT({!Loop_Peers.Measured_Value__c}) &amp; &apos; | 기준선대비 &apos; &amp; TEXT({!Loop_Peers.Drift_From_Baseline__c}) &amp; &apos;%\n&apos;</expression>
    </formulas>
    <interviewLabel>Case_Dispatch_Briefing_Generate</interviewLabel>
    <label>출동 브리핑 생성</label>
    <loops>
        <description>Iterates through peer equipment inspection line items to build the peer comparison text, kept separate from the current asset history</description>
