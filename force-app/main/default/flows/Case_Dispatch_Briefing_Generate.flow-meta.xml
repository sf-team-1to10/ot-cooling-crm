    <decisions>
        <locationY>50</locationY>
        <locationX>1058</locationX>
        <name>Check_Current</name>
        <description>Captures the current value only from the latest inspection flow reading, once</description>
        <label>Check Current</label>
        <defaultConnector>
            <targetReference>Loop_WOLIs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Current</defaultConnectorLabel>
        <rules>
            <name>Is_Current_Reading</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCaptured</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_WOLIs.Line_Item_Role__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>점검</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_WOLIs.Measurement_Item_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>유량</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Current</targetReference>
            </connector>
            <label>Is Current Reading</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>History_Line</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!Loop_WOs.StartDate}))) &amp; '-' &amp; TEXT(MONTH(DATEVALUE({!Loop_WOs.StartDate}))) &amp; '-' &amp; TEXT(DAY(DATEVALUE({!Loop_WOs.StartDate}))) &amp; ' | ' &amp; TEXT({!Loop_WOLIs.Line_Item_Role__c}) &amp; ' | ' &amp; TEXT({!Loop_WOLIs.Measurement_Item_Code__c}) &amp; ' | 측정 ' &amp; TEXT({!Loop_WOLIs.Measured_Value__c}) &amp; ' | 기준선 ' &amp; TEXT({!Loop_WOLIs.Baseline_Value__c}) &amp; ' | 기준선대비 ' &amp; TEXT({!Loop_WOLIs.Drift_From_Baseline__c}) &amp; '% | 판정 ' &amp; TEXT({!Loop_WOLIs.Judgement__c}) &amp; ' | 추세 ' &amp; TEXT({!Loop_WOLIs.Trend_Flag__c}) &amp; ' | 회차 ' &amp; TEXT({!Loop_WOLIs.Retest_Round__c}) &amp; ' | 사유 ' &amp; TEXT({!Loop_WOLIs.Retest_Reason__c}) &amp; ' | 조치 ' &amp; {!Loop_WOLIs.Corrective_Action__c} &amp; '\n'</expression>
    </formulas>
    <formulas>
        <name>Current_Reading_Line</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!Loop_WOs.StartDate}))) &amp; '-' &amp; TEXT(MONTH(DATEVALUE({!Loop_WOs.StartDate}))) &amp; '-' &amp; TEXT(DAY(DATEVALUE({!Loop_WOs.StartDate}))) &amp; ' 측정 ' &amp; TEXT({!Loop_WOLIs.Measurement_Item_Code__c}) &amp; ' ' &amp; TEXT({!Loop_WOLIs.Measured_Value__c}) &amp; ' | 기준선 ' &amp; TEXT({!Loop_WOLIs.Baseline_Value__c}) &amp; ' | 기준선대비 ' &amp; TEXT({!Loop_WOLIs.Drift_From_Baseline__c}) &amp; '% | 판정 ' &amp; TEXT({!Loop_WOLIs.Judgement__c}) &amp; ' | 추세 ' &amp; TEXT({!Loop_WOLIs.Trend_Flag__c})</expression>
    </formulas>
    <formulas>
        <name>Peer_Line</name>
        <dataType>String</dataType>
        <expression>{!Loop_Peers.Asset.Name} &amp; ' | 측정 ' &amp; TEXT({!Loop_Peers.Measured_Value__c}) &amp; ' | 기준선대비 ' &amp; TEXT({!Loop_Peers.Drift_From_Baseline__c}) &amp; '%\n'</expression>
    </formulas>
