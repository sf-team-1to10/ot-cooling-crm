    <formulas>
        <name>Case_Line</name>
        <dataType>String</dataType>
        <expression>{!Loop_Cases.CaseNumber} &amp; ' | 접수 ' &amp; TEXT(DATEVALUE({!Loop_Cases.CreatedDate})) &amp; ' | 종료 ' &amp; IF(ISBLANK({!Loop_Cases.ClosedDate}), '(미종료)', TEXT(DATEVALUE({!Loop_Cases.ClosedDate}))) &amp; ' | 증상 ' &amp; TEXT({!Loop_Cases.Symptom_Category__c}) &amp; ' | 원인 ' &amp; IF(ISBLANK({!Loop_Cases.Diagnosed_Cause__c}), '(미규명)', {!Loop_Cases.Diagnosed_Cause__c}) &amp; ' | 복구시간 ' &amp; IF(ISBLANK({!Loop_Cases.ClosedDate}), '', TEXT(ROUND(({!Loop_Cases.ClosedDate} - {!Loop_Cases.CreatedDate}) * 24, 1))) &amp; '\n'</expression>
    </formulas>
    <formulas>
