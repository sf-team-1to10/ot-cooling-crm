<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>CR 상태변경 알림 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CR 상태변경 고객 알림</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Send_Status_Change_Email</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Status}) &amp;&amp; NOT(ISBLANK({!$Record.Requester__r.Email}))</filterFormula>
        <object>ChangeRequest</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>EmailSubject</name>
        <text>[변경요청] 상태가 &apos;{!$Record.Status}&apos;(으)로 변경되었습니다</text>
    </textTemplates>
    <textTemplates>
        <name>EmailBody</name>
        <text>안녕하세요,

요청하신 변경요청 건의 상태가 변경되었습니다.

- 제목: {!$Record.Subject}
- 현재 상태: {!$Record.Status}
- 변경요청 번호: {!$Record.ChangeRequestNumber}

문의사항은 담당자에게 연락 부탁드립니다.
감사합니다.</text>
    </textTemplates>
    <actionCalls>
        <name>Send_Status_Change_Email</name>
        <label>상태 변경 메일 발송</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Requester__r.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>EmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>DefaultWorkflowUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
</Flow>
