<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>영향도(ImpactLevel)에 따라 시정조치 WO(High) 또는 예방점검 WO(Medium)를 생성한다. Low/기타는 종료.</description>
        <name>Route_By_Impact_Level</name>
        <label>Route By Impact Level</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>기타 - 종료</defaultConnectorLabel>
        <rules>
            <name>High_Corrective</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ImpactLevel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Corrective_WO</targetReference>
            </connector>
            <label>High - 시정조치</label>
        </rules>
        <rules>
            <name>Medium_Preventive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ImpactLevel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Preventive_WO</targetReference>
            </connector>
            <label>Medium - 예방점검</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>시정조치 WO 제목 - 영향 자산과 RCA 건 참조</description>
        <name>Corrective_Subject_Formula</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;[시정조치] &quot; &amp; {!$Record.Asset.Name} &amp; &quot; - &quot; &amp; {!$Record.Problem.Subject}, 255)</expression>
    </formulas>
    <formulas>
        <description>예방점검 WO 제목 - 동일 모델 유사장비 예방점검</description>
        <name>Preventive_Subject_Formula</name>
        <dataType>String</dataType>
        <expression>LEFT(&quot;[예방점검] &quot; &amp; {!$Record.Asset.Name} &amp; &quot; - 동일모델 예방점검 (&quot; &amp; {!$Record.Problem.Subject} &amp; &quot;)&quot;, 255)</expression>
    </formulas>
    <interviewLabel>PRI Corrective Preventive WO Dispatch</interviewLabel>
    <label>PRI_Corrective_Preventive_WO_Dispatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>영향도 High 자산에 시정조치 WorkOrder 1건 생성. Problem__c로 RCA 건 연결.</description>
        <name>Create_Corrective_WO</name>
        <label>Create Corrective WO</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AssetId</field>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Problem__c</field>
            <value>
                <elementReference>$Record.ProblemId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Corrective_Subject_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Work_Subtype__c</field>
            <value>
                <stringValue>시정조치</stringValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>영향도 Medium 유사장비에 예방점검 WorkOrder 1건 생성. Problem__c로 RCA 건 연결.</description>
        <name>Create_Preventive_WO</name>
        <label>Create Preventive WO</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AssetId</field>
            <value>
                <elementReference>$Record.AssetId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Problem__c</field>
            <value>
                <elementReference>$Record.ProblemId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Preventive_Subject_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Work_Subtype__c</field>
            <value>
                <stringValue>예방정비</stringValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_By_Impact_Level</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK(TEXT({!$Record.ImpactLevel}))) &amp;&amp; NOT(ISBLANK({!$Record.AssetId})) &amp;&amp; NOT(ISBLANK({!$Record.ProblemId}))</filterFormula>
        <object>ProblemRelatedItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
