    <variables>
        <description>Asset 기준 유효 Entitlement 후보 건수. 1일 때만 배정한다.</description>
        <name>varCandidateCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
