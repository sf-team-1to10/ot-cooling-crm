<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>T5-22 — Agent(증상 상담)가 Case 생성 전 Knowledge Article을 검색한다. T5AgentKnowledgeSearchAction Apex를 감싸는 Agentforce Action용 Flow(T5_Agent_Create_Case_From_Consultation과 같은 패턴).</description>
    <interviewLabel>T5 Agent Search Knowledge {!$Flow.CurrentDateTime}</interviewLabel>
    <label>T5 Agent: Search Knowledge</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Call_Apex_Search_Knowledge</targetReference>
        </connector>
    </start>

    <variables>
        <name>queryText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>고객이 설명한 증상 원문 또는 핵심 키워드</description>
    </variables>

    <variables>
        <name>found</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>articleTitle</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>articleSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>articleUrlName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <actionCalls>
        <name>Call_Apex_Search_Knowledge</name>
        <label>Search Knowledge via Apex</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>T5AgentKnowledgeSearchAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>queryText</name>
            <value><elementReference>queryText</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>found</assignToReference>
            <name>found</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>articleTitle</assignToReference>
            <name>articleTitle</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>articleSummary</assignToReference>
            <name>articleSummary</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>articleUrlName</assignToReference>
            <name>articleUrlName</name>
        </outputParameters>
    </actionCalls>
</Flow>
