<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <description>Choice for additional change scope</description>
        <name>Scope_Additional_Change</name>
        <choiceText>추가변경</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>추가변경</stringValue>
        </value>
    </choices>
    <choices>
        <description>Choice for original contract scope</description>
        <name>Scope_Original_Contract</name>
        <choiceText>원계약 범위</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>원계약 범위</stringValue>
        </value>
    </choices>
    <environments>Default</environments>
    <interviewLabel>CR 1단계 접수판별</interviewLabel>
    <label>CR 1단계 접수판별</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Retrieves the ChangeRequest record by recordId to display context fields on the triage screen</description>
        <name>Get_ChangeRequest</name>
        <label>Get ChangeRequest</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Triage_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ChangeRequest</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Origin__c</queriedFields>
        <queriedFields>Requester__c</queriedFields>
        <queriedFields>Received_Date__c</queriedFields>
        <queriedFields>Contract__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the ChangeRequest record&apos;s Scope_Type__c field with the value selected by the reviewer on the triage screen</description>
        <name>Update_ChangeRequest_Scope</name>
        <label>Update ChangeRequest Scope</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Scope_Type__c</field>
            <value>
                <elementReference>scopeType</elementReference>
            </value>
        </inputAssignments>
        <object>ChangeRequest</object>
    </recordUpdates>
    <screens>
        <description>Displays read-only ChangeRequest context fields and captures user input for Scope_Type__c determination</description>
        <name>Triage_Screen</name>
        <label>Triage Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Update_ChangeRequest_Scope</targetReference>
        </connector>
        <fields>
            <description>Display-only field showing the Description from the retrieved ChangeRequest record</description>
            <name>crDescription</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Description:&lt;/b&gt; {!Get_ChangeRequest.Description}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Display-only field showing the Origin__c from the retrieved ChangeRequest record</description>
            <name>crOrigin</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Origin:&lt;/b&gt; {!Get_ChangeRequest.Origin__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Display-only field showing the Requester__c (Contact) from the retrieved ChangeRequest record</description>
            <name>crRequester</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Requester:&lt;/b&gt; {!Get_ChangeRequest.Requester__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Display-only field showing the Received_Date__c from the retrieved ChangeRequest record</description>
            <name>crReceivedDate</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Received Date:&lt;/b&gt; {!Get_ChangeRequest.Received_Date__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Display-only field showing the Contract__c from the retrieved ChangeRequest record</description>
            <name>crContract</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Contract:&lt;/b&gt; {!Get_ChangeRequest.Contract__c}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <description>Input field for reviewer to select scope type (원계약 범위 or 추가변경). User provides data, so mapped_to_field is null. References Scope_Original_Contract and Scope_Additional_Change choices.</description>
            <name>scopeType</name>
            <choiceReferences>Scope_Original_Contract</choiceReferences>
            <choiceReferences>Scope_Additional_Change</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Scope Type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_ChangeRequest</targetReference>
        </connector>
        <triggerType>None</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Input variable that receives the ChangeRequest record Id when the flow is invoked</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
